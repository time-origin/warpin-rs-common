      "manifest": "[package]\nname = \"warpin-protocol-release-smoke\"\nversion = \"0.0.0\"\nedition = \"2024\"\n[dependencies]\nwarpin-http = \"=0.2.11\"\nwarpin-transport = \"=0.2.11\"\nwarpin-mqtt = \"=0.2.11\"\nwarpin-modbus = \"=0.2.11\"\nwarpin-errors = \"=0.2.11\"\n",
      "test_source": "use std::time::Duration;\nuse warpin_transport::Limits;\nuse warpin_http::transport::{Authentication,HttpLimits,HttpTransport,Security};\npub fn consumer_api_smoke()->Result<(),Box<dyn std::error::Error>>{\n Limits{timeout:Duration::from_secs(1),max_frame_bytes:1024}.validate()?;\n let _http=HttpTransport::new(\"https://example.com/\",Security::Https,Authentication::None,HttpLimits{connect_timeout:Duration::from_secs(1),read_timeout:Duration::from_secs(1),total_timeout:Duration::from_secs(2),max_request_bytes:1024,max_response_bytes:4096,max_in_flight:2})?;\n let layout=warpin_modbus::registers::Layout{words:warpin_modbus::registers::Order::Big,bytes:warpin_modbus::registers::Order::Big};assert_eq!(layout.u32(&[0,42])?,42);\n let _version=warpin_mqtt::Version::V5{clean_start:true,session_expiry_seconds:0};\n let error=warpin_errors::protocol::ProtocolError::new(warpin_errors::protocol::Kind::OutcomeUnknown,warpin_errors::protocol::Phase::Write);assert_eq!(error.service_error().code,503);Ok(())\n}\n#[test]fn standalone_consumer(){consumer_api_smoke().expect(\"published API\");}\n"
    },
